# panel-hub config — copy to hub.env and fill in values
# All three proxy services are now handled on HUB_PORT (default 8768).
# Update esphome/packages/secrets.yaml to point all three proxy URLs to this port.

# ── Port ─────────────────────────────────────────────────────────────────────
HUB_PORT=8768

# ── Immich ───────────────────────────────────────────────────────────────────
IMMICH_URL=http://192.168.55.59:2283
IMMICH_API_KEY=REPLACE_WITH_IMMICH_API_KEY

# Slideshow tuning
MAX_W=800
MAX_H=480
JPEG_QUALITY=78
RETRIES=8
PORTRAIT_PREFER=true
PORTRAIT_BATCH=4

# Optional: restrict slideshow to favourites or specific people
FAVORITES_ONLY=false
# IMMICH_PERSON_NAMES=Mukta Rani,Advik Sah,Ashok Kumar Sah

# ── Home Assistant ────────────────────────────────────────────────────────────
# Used for camera proxy and calendar refresh
HA_URL=http://192.168.55.111:8123
HA_TOKEN=REPLACE_WITH_HA_LONG_LIVED_TOKEN

# ── Jellyfin ──────────────────────────────────────────────────────────────────
JELLYFIN_URL=http://192.168.55.59:8096
JELLYFIN_API_KEY=REPLACE_WITH_JELLYFIN_API_KEY
# Optional: pin a specific user UUID; leave blank to use the first user
# JELLYFIN_USER_ID=
# Optional: direct play to a Jellyfin client by DeviceName/Client substring
# JELLYFIN_PLAY_CLIENT=Living Room TV
POSTER_MAX_W=280
POSTER_MAX_H=400
POSTER_QUALITY=85

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_URL=http://192.168.55.59:11434
OLLAMA_MODEL=llama3.2

# ── Tuya ─────────────────────────────────────────────────────────────────────
DEVICES_FILE=/app/devices.json

# ── Panel dynamic config ──────────────────────────────────────────────────────
# Camera slots served to the panel at boot via GET /panel/config.
# Copy panel_config.json.example to panel_config.json and edit as needed.
PANEL_CONFIG_FILE=/app/panel_config.json

# ── Calendar refresh ─────────────────────────────────────────────────────────
CALENDAR_REFRESH_HRS=1
