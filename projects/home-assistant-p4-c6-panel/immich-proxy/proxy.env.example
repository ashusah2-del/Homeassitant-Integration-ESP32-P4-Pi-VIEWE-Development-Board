IMMICH_URL=http://your-immich-host:2283
IMMICH_API_KEY=<your-immich-api-key>
PROXY_PORT=8765
# Cap output to keep JPEGDEC decode time on the panel under the 5 s
# task-watchdog window. 800x480 + quality 78 + 4:2:0 chroma subsampling
# (handled in proxy.py) lands worst-case decode at ~1.2 s.
MAX_W=800
MAX_H=480
JPEG_QUALITY=78
RETRIES=8
# Default false: use the full Immich image library for the slideshow.
# Set true to restrict /random-photo to favourite images only.
FAVORITES_ONLY=false
# Optional comma-separated Immich people names. When set, /random-photo only
# returns photos containing at least one matching person.
IMMICH_PERSON_NAMES=Mukta Rani,Advik Sah,Ashok Kumar Sah
# Comma-separated, case-insensitive substrings matched against each asset's
# originalPath — matching assets are skipped (e.g. AI-upscaled/enhanced
# photos under the "AI Images" external library folder).
AI_EXCLUDE_PATHS=AI Images

# For /camera/<name> endpoint — long-lived HA token (gitignored in prod)
HA_URL=http://your-ha-host:8123
HA_TOKEN=<your-ha-long-lived-access-token>
