# Copy to proxy.env and fill in values.
JELLYFIN_URL=http://192.168.1.50:8096
JELLYFIN_API_KEY=REPLACE_WITH_JELLYFIN_API_KEY

# Optional: pin a specific Jellyfin user UUID. Leave blank to use the first user.
# JELLYFIN_USER_ID=

# Optional: start playback on an active Jellyfin client whose DeviceName/Client
# contains this substring (case-insensitive). Used by POST /play/<item_id>.
# JELLYFIN_PLAY_CLIENT=Living Room TV

PROXY_PORT=8767
JPEG_QUALITY=85
MAX_W=280
MAX_H=400
