# Copy to proxy.env and fill in IHOST_TOKEN.
#
# To get a token:
#   1. Press the physical button on the iHost
#   2. Within 5 minutes, run:  bash get_token.sh
#   3. The token is saved to proxy.env automatically
#   4. Restart the service: systemctl --user restart ihost-proxy
#
# The token survives reboots but is cleared on factory reset.

IHOST_URL=http://ihost.local
IHOST_TOKEN=

PROXY_PORT=8768
