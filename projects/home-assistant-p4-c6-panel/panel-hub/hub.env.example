# panel-hub config — copy to hub.env and fill in values
# All three proxy services are now handled on HUB_PORT (default 8768).
# Update esphome/packages/secrets.yaml to point all three proxy URLs to this port.
#
# IMPORTANT — host-local service URLs (IMMICH_URL / JELLYFIN_URL / OLLAMA_URL):
# For services running on the SAME Docker host, point these at the Docker
# bridge gateway 172.17.0.1, NOT the host's own LAN IP (e.g. 192.168.55.59).
# A container cannot reliably reach the host's own WiFi IP for a published port
# (the AP won't hairpin the traffic back), so 192.168.55.59:<port> times out
# from inside the container while 172.17.0.1:<port> works. Services on OTHER
# machines (HA on .111, iHost on .79) keep their real LAN IPs.
# After editing this file: `docker compose up -d --force-recreate` — a plain
# `docker restart` does NOT reload env_file.

# ── Port ─────────────────────────────────────────────────────────────────────
HUB_PORT=8768

# ── Immich ───────────────────────────────────────────────────────────────────
# host-local → use the docker gateway, not the host LAN IP (see note at top)
IMMICH_URL=http://172.17.0.1:2283
IMMICH_API_KEY=REPLACE_WITH_IMMICH_API_KEY

# Slideshow tuning
MAX_W=800
MAX_H=480
JPEG_QUALITY=78
RETRIES=8
PORTRAIT_PREFER=true
PORTRAIT_BATCH=4

# Optional: restrict slideshow to favourites or specific people
FAVORITES_ONLY=false
# IMMICH_PERSON_NAMES=Mukta Rani,Advik Sah,Ashok Kumar Sah

# Comma-separated, case-insensitive substrings matched against each asset's
# originalPath — matching assets are skipped (e.g. AI-upscaled/enhanced photos
# under the "AI Images" external library folder).
AI_EXCLUDE_PATHS=AI Images

# ── Home Assistant ────────────────────────────────────────────────────────────
# Used for camera proxy and calendar refresh
HA_URL=http://192.168.55.111:8123
HA_TOKEN=REPLACE_WITH_HA_LONG_LIVED_TOKEN

# ── Jellyfin ──────────────────────────────────────────────────────────────────
# host-local → use the docker gateway, not the host LAN IP (see note at top)
JELLYFIN_URL=http://172.17.0.1:8096
JELLYFIN_API_KEY=REPLACE_WITH_JELLYFIN_API_KEY
# Optional: pin a specific user UUID; leave blank to use the first user
# JELLYFIN_USER_ID=
# Optional: direct play to a Jellyfin client by DeviceName/Client substring
# JELLYFIN_PLAY_CLIENT=Living Room TV
POSTER_MAX_W=280
POSTER_MAX_H=400
POSTER_QUALITY=85

# ── Ollama ───────────────────────────────────────────────────────────────────
# host-local → use the docker gateway, not the host LAN IP (see note at top)
OLLAMA_URL=http://172.17.0.1:11434
OLLAMA_MODEL=llama3.2

# ── Tuya ─────────────────────────────────────────────────────────────────────
DEVICES_FILE=/app/devices.json

# ── Panel dynamic config ──────────────────────────────────────────────────────
# Camera slots served to the panel at boot via GET /panel/config.
# Copy panel_config.json.example to panel_config.json and edit as needed.
PANEL_CONFIG_FILE=/app/panel_config.json

# ── Calendar refresh ─────────────────────────────────────────────────────────
CALENDAR_REFRESH_HRS=1

# ── iHost / eWeLink ───────────────────────────────────────────────────────────
# Press the button on the iHost, then run ihost-proxy/get_token.sh to get token.
# Routes exposed at /ihost/health, /ihost/devices, /ihost/device/<serial>/...
IHOST_URL=http://ihost.local
IHOST_TOKEN=
