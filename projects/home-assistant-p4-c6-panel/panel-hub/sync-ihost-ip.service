[Unit]
Description=Sync iHost mDNS name to panel-hub hub.env IHOST_URL
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash "%h/docker/ESPs3 Device/projects/home-assistant-p4-c6-panel/panel-hub/sync-ihost-ip.sh"
StandardOutput=journal
StandardError=journal
