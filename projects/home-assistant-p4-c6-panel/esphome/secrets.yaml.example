# Copy this file to secrets.yaml and replace all values.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

fallback_ap_ssid: "Guition P4 7inch Fallback"
fallback_ap_password: "CHANGE_ME_12+_CHARS"

# Generate with: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# Generate with: openssl rand -base64 24
ota_password: "REPLACE_WITH_OTA_PASSWORD"

# Create in Immich under Account Settings -> API Keys
immich_api_key: "REPLACE_WITH_IMMICH_API_KEY"

# panel-hub — all three proxy services are now unified on port 8768.
# See panel-hub/hub.env.example for server-side config.
# All three variables below point to the same host:port.
immich_proxy_url: "http://YOUR_DOCKER_HOST_IP:8768"
jellyfin_proxy_url: "http://YOUR_DOCKER_HOST_IP:8768"
tuya_bridge_url: "http://YOUR_DOCKER_HOST_IP:8768"

# Direct Jellyfin API (used for deep-link cast URLs — NOT for proxied images)
jellyfin_server_url: "http://YOUR_JELLYFIN_HOST:8096"
jellyfin_api_key: "REPLACE_WITH_JELLYFIN_API_KEY"