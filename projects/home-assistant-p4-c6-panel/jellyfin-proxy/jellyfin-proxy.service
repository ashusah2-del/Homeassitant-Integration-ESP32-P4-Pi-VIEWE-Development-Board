[Unit]
Description=Jellyfin browse proxy for ESP32-P4 panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/docker/jellyfin-proxy
EnvironmentFile=%h/docker/jellyfin-proxy/proxy.env
ExecStart=/usr/bin/python3 %h/docker/jellyfin-proxy/proxy.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
